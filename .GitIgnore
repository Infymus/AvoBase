# Ignore Visual Studio temporary files, build results, and
# files generated by popular tools like NuGet.

## Ignore build output ##
bin/
obj/

## Ignore NuGet Packages ##
*.nupkg
packages/
*.snupkg

## Ignore by-products of VS Code ##
.vscode/

## Ignore Visual Studio specific folders ##
.vs/

## Ignore user-specific files ##
*.user
*.suo
*.sln.docstates
*.vsconfig

## Ignore build-related files ##
project.lock.json
project.fragment.lock.json
artifacts/

## Ignore Resharper and Rider files ##
_ReSharper*/  
*.DotSettings.user  
.idea/

## Ignore JetBrains Rider ##
.idea/
*.sln.iml

## Ignore files related to Azure Functions ##
local.settings.json

## Ignore Mac OS files ##
.DS_Store

## Ignore Windows files ##
Thumbs.db
desktop.ini

## Ignore auto-generated files by Visual Studio ##
Generated_Code/

## Ignore logs and databases ##
*.log
*.tlog
*.pdb
*.db
*.sqlite
*.sqlite3

## Ignore temporary files ##
*.tmp
*.bak
*.old
*.swp
*.slnide

## Ignore test results ##
TestResults/
*.trx
*.coverage

## Ignore files generated during builds ##
*.exe
*.app
*.lib
*.js
*.css.map
*.js.map

## Ignore Borland BDE Database Files ##
*.PX
*.MB
*.YG*
*.XG*
*.DB

## Ignore publish output ##
/RES/
/regexpr/
/TABLE_REPAIR/
/AutoUpdater/
/Images/
/Installer/
/RSS_FEED_EXAMPLES/
/Test_Programs/
/TORRENT_EXAMPLES/
/Website/
/WEBSITE_DB/
/_BACKUP/
/_TODO/
/Documentation/


## Ignore node_modules for projects using Node.js ##
node_modules/

## Ignore coverage files ##
coverage/

# Others
*.cache
*.pyc

# Delphi intermediate compiled units and binaries
*.dcu
*.exe
pdoxusrs.net
*.bpl
updates.txt
*.dcp
*.~*

# Delphi IDE internal states & history & Files we don't want
*.rtf
*.identcache
*.local
*.stat
*.dsk
/__history/
*.bat
*.odt

# Images
*.bmp
*.jpg
*.ico
*.gif
*.tga

# Visual Studio folder workspace state
.vs/

/Deploy
