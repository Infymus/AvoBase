		<Target Name="Make">
			<CallTarget Targets="AvoBase:Make;AvoAutoUpdater:Make;HelpMaker:Make"/>
		</Target>
		<Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
	</Project>
