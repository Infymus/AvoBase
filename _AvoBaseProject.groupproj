		</Target>
		<Target Name="HelpMaker:Make">
			<MSBuild Targets="Make" Projects="HelpMaker\HelpMaker.dproj"/>
		</Target>
		<Target Name="Build">
			<CallTarget Targets="AvoBase;AvoAutoUpdater;HelpMaker"/>
		</Target>
		<Target Name="Clean">
			<CallTarget Targets="AvoBase:Clean;AvoAutoUpdater:Clean;HelpMaker:Clean"/>
